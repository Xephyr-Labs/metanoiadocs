# Copy to .env and fill in. Only DB_PASSWORD is strictly required to boot.

# How the app is reached (used in emailed links). Local default is fine to start.
BASE_URL=http://localhost:8092

# Postgres password for the bundled db container (pick anything).
DB_PASSWORD=change-me

# Optional. Leave both empty and the first visit shows a setup screen where you
# create the admin account in the browser. Set both to create it unattended
# instead — they apply only while the instance has no accounts at all. There is
# no default password: an unclaimed instance cannot be signed into.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional display name / username for that unattended admin (default: Admin / admin).
ADMIN_NAME=
ADMIN_USERNAME=

# true = print the sign-in link to `docker compose logs server` instead of
# emailing it, so you can try the app with no SMTP configured.
AUTH_DEV_MODE=true

# Who may sign in. Empty = deny-all. Comma-separated domains, or * for anyone.
ALLOWED_EMAIL_DOMAINS=*

# Days a page stays in the trash before it is destroyed for good. The sweeper
# runs at boot and every six hours after. Minimum 1.
TRASH_RETENTION_DAYS=30

# The hour (0–23, server clock) the daily task reminders go out: one summary
# per person, plus a line for anything due tomorrow, due today or overdue.
# Nothing is sent before it, so a reminder is not read at 3am with fourteen
# others. The sweep re-checks every half hour and never repeats itself.
REMINDER_HOUR=8

# SMTP for real sign-in / invite / notification emails (optional in dev mode).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=MetanoiaDocs <no-reply@example.com>

# Minutes before an agent run that was claimed but never reported on goes back
# on the queue. A runner's machine gets closed or loses the network mid-task;
# without this the work is stuck behind a process that no longer exists.
AGENT_RUN_STALE_MIN=30
