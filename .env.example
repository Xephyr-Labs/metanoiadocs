# Copy to .env and fill in. Only DB_PASSWORD is strictly required to boot.

# How the app is reached (used in emailed links). Local default is fine to start.
BASE_URL=http://localhost:8092

# Postgres password for the bundled db container (pick anything).
DB_PASSWORD=change-me

# First-run admin account. If unset, a default admin/admin123 is seeded with a
# loud warning — set these before exposing the instance.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# true = print the sign-in link to `docker compose logs server` instead of
# emailing it, so you can try the app with no SMTP configured.
AUTH_DEV_MODE=true

# Who may sign in. Empty = deny-all. Comma-separated domains, or * for anyone.
ALLOWED_EMAIL_DOMAINS=*

# Days a page stays in the trash before it is destroyed for good. The sweeper
# runs at boot and every six hours after. Minimum 1.
TRASH_RETENTION_DAYS=30

# SMTP for real sign-in / invite / notification emails (optional in dev mode).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=MetanoiaDocs <no-reply@example.com>
