{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": false,
  "include-component-in-tag": false,
  "changelog-sections": [
    { "type": "feat", "section": "Features" },
    { "type": "fix", "section": "Fixes" },
    { "type": "perf", "section": "Performance" },
    { "type": "docs", "section": "Documentation" },
    { "type": "refactor", "section": "Refactors", "hidden": true },
    { "type": "chore", "section": "Chores", "hidden": true },
    { "type": "test", "section": "Tests", "hidden": true }
  ],
  "packages": {
    ".": {
      "package-name": "metanoiadocs",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        { "type": "json", "path": "server/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "web-react/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "runner/package.json", "jsonpath": "$.version" }
      ]
    }
  }
}
